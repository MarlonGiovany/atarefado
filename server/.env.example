NODE_ENV="development"
# PostgreSQL connection string.
# Local: run `npm run db:local` (starts Prisma's local Postgres) and use the TCP URL it prints, e.g.
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Production: the URL from your host (Render, Railway, Neon, ...), usually with ?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
PORT=3333
# Front-end address: allowed origin for CORS/CSRF and base for links in e-mails.
# Must be https:// in production (the public URL of the app).
CLIENT_URL="http://localhost:5173"
# Behind a reverse proxy (e.g. Render, Nginx), set the number of proxy hops ("1")
TRUST_PROXY=""
# Serve the built front-end (client/dist) from this server. Defaults to "true" in
# production and "false" in development (Vite serves the front-end).
SERVE_CLIENT=""
CLIENT_DIST="../client/dist"

# Optional: OAuth "Web application" client id from Google Cloud Console
# (e.g. 1234567890-abc.apps.googleusercontent.com). Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=""

# SMTP for password reset e-mails (required in production).
# In development, leave SMTP_HOST empty: e-mails are saved to server/.mail-outbox/.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Atarefado <no-reply@atarefado.dev>"
