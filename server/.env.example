NODE_ENV="development"
# PostgreSQL connection string.
# Local: run `npm run db:local` (starts Prisma's local Postgres) and use the TCP URL it prints, e.g.
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Production: the URL from your provider (on Vercel: Neon, pooled URL), usually with ?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Direct (non-pooled) URL used only by migrations. Set automatically by the Neon
# integration on Vercel; when empty, DATABASE_URL is used.
DATABASE_URL_UNPOOLED=""
# Connections per server instance. The local database (npm run db:local) accepts
# only one at a time, so keep 1 locally; leave empty in production (default 10).
DATABASE_POOL_MAX=1
# Milliseconds an idle connection stays open (default 10000). Leave empty; only the
# two-instance test (tests/serverless.test.mts) sets it, because the local database
# refuses a second connection while one is open.
DATABASE_IDLE_TIMEOUT_MS=
PORT=3333
# Front-end address: allowed origin for CORS/CSRF and base for links in e-mails.
# Must be https:// in production. On Vercel it defaults to the project's production
# domain (or the preview URL), so it only needs setting for a custom setup.
CLIENT_URL="http://localhost:5173"
# Behind a reverse proxy (e.g. Render, Nginx), set the number of proxy hops ("1").
# On Vercel it defaults to "1".
TRUST_PROXY=""
# Serve the built front-end (client/dist) from this server. Defaults to "true" in
# production and "false" in development (Vite serves the front-end) and on Vercel
# (its CDN serves it).
SERVE_CLIENT=""
CLIENT_DIST="../client/dist"

# Optional: OAuth "Web application" client id from Google Cloud Console
# (e.g. 1234567890-abc.apps.googleusercontent.com). Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=""

# SMTP for password reset e-mails (required in production).
# In development, leave SMTP_HOST empty: e-mails are saved to server/.mail-outbox/.
# Example (Brevo, free plan): SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT=587,
# SMTP_USER = your Brevo SMTP login, SMTP_PASS = an SMTP key from Brevo.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Sender; must be an address/domain verified with your e-mail provider
MAIL_FROM="Atarefado <no-reply@atarefado.dev>"
