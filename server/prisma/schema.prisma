generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  // Null for accounts that only sign in with Google
  passwordHash String?
  // Google account id ("sub" claim); set once the user signs in with Google
  googleId     String?       @unique
  createdAt    DateTime      @default(now())
  memberships  BoardMember[]
  assigned     Card[]        @relation("CardAssignee")
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  googleLinks  GoogleLinkRequest[]
}

// Server-side login session. The browser holds a random token in an HttpOnly
// cookie; only its SHA-256 hash is stored, so a database leak can't be replayed.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// "Esqueci minha senha": single-use, short-lived, stored only as a hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// A Google sign-in that matched an existing password account by e-mail. The
// Google identity is only linked after the user confirms that account's password.
model GoogleLinkRequest {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId  String
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// Rate limit and failed-login counters (fixed window per key). Kept in the
// database so every server instance sees the same counts: serverless functions
// don't share memory. The key is a SHA-256 hash, so no e-mail or IP is stored.
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

model Board {
  id        String        @id @default(cuid())
  title     String
  // Readable, unique address: /quadros/<slug> ("tarefas-diarias", "tarefas-diarias-2").
  // Follows the title on rename. Access is still checked by membership.
  slug      String        @unique
  createdAt DateTime      @default(now())
  members   BoardMember[]
  columns   Column[]
}

// role: "OWNER" | "MEMBER" (validated in code)
model BoardMember {
  boardId String
  userId  String
  role    String @default("MEMBER")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Column {
  id       String @id @default(cuid())
  title    String
  position Float
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  position    Float
  // Day the task belongs to, stored as UTC midnight (date-only semantics)
  date        DateTime
  columnId    String
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?    @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([columnId])
  @@index([date])
}
